# NOTE: supabase-config.js is intentionally NOT ignored.
# The site is a static GitHub Pages deploy, so this file must ship to the browser.
# It only holds the Supabase project URL + the publishable (anon) key, which are
# safe for public clients and are protected by Row Level Security. Never put a
# service_role key in this repo.
